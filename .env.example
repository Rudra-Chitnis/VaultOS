# VaultOS configuration template
# Copy to .env and set PASS_HASH before running.
#
# Generate PASS_HASH:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"

# Required: SHA-256 hash of the password used on the login screen.
PASS_HASH=replace_with_sha256_password_hash

# Node/Express service
PORT=8000
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Python face AI service
FACE_SERVICE_HOST=127.0.0.1
FACE_SERVICE_PORT=7860
FACE_SERVICE_URL=http://127.0.0.1:7860

# Face detection quality thresholds
FACE_MIN_CONFIDENCE=0.45
FACE_MIN_SIZE=80
FACE_BLUR_THRESHOLD=80
FACE_FRONTAL_MAX_DEV=0.40
FACE_EYE_ROLL_MAX=0.45
FACE_MAX_PER_IMAGE=10

# Face clustering thresholds
FACE_HDBSCAN_MIN_CLUSTER=2
FACE_HDBSCAN_MIN_SAMPLES=1
FACE_CENTROID_MERGE_SIM=0.72
FACE_NOISE_REASSIGN_DIST=1.0
FACE_REFINE_SMALL_THRESH=3
FACE_REFINE_ABSORB_SIM=0.62
FACE_TEMPORAL_WINDOW_MS=5000
FACE_TEMPORAL_MERGE_SIM=0.60
FACE_MERGE2_SIM=0.68
FACE_CENTROID_WEIGHT_PWR=1.5

# Incremental assignment in the Node face worker
FACE_SIMILARITY_THRESHOLD=0.55
FACE_MARGIN_THRESHOLD=0.05
FACE_WORKER_CONCURRENCY=2

# Logging
FACE_DEBUG=
FACE_LOG_JSON=
